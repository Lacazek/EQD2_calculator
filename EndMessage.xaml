<Window x:Class="EQD2_Calculator.EndMessage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EQD2_Calculator"
        mc:Ignorable="d"
        Title="EndMessage" Height="250" Width="550">
    <Grid Background="#FFFF937B">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.05*"/>
            <ColumnDefinition Width="0.2*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="0.25*"/>
            <ColumnDefinition Width="0.05*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.05*"/>
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="0.025*"/>
            <RowDefinition Height="0.05*"/>
            <RowDefinition Height="0.025*"/>
        </Grid.RowDefinitions>
        <Button x:Name="Ok_Button" Grid.Column="3" Content="OK" Grid.Row="4"  Click="Button_Click" Background="#FF87F15E"/>
        <TextBlock Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1" Grid.RowSpan="2" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontStyle="Italic" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"><Run Language="fr-fr" Text="Attention"/><Run Text=" : L'utilisateur est responsable des résultats obtenus par l'utilisation de ce script"/></TextBlock>
    </Grid>
</Window>
